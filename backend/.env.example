DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Razorpay test credentials (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# QR token HMAC secret — any random string
QR_HMAC_SECRET=change-this-to-a-random-secret-string

# Redis (for production channel layers — leave blank for in-memory dev)
REDIS_URL=redis://localhost:6379/0
